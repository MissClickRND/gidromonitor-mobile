<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.GidroMonitor" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.GidroMonitor.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_loader</item>
        <item name="windowSplashScreenBackground">#F4F8FA</item>
        <item name="postSplashScreenTheme">@style/Theme.GidroMonitor</item>
    </style>
</resources>
